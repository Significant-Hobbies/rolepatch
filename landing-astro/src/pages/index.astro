---
import Base from '@saas-maker/templates/Base.astro';
import { WorkbenchPage } from '@saas-maker/templates/workbench-page';
import { baseProps } from '@saas-maker/templates/page';
import { workbenchContent } from '@saas-maker/templates/schema';
import { APP_HEALTH_CLICK_SCRIPT, PRODUCT_FAQS, productJsonLd, REDIRECT_AUTHENTICATED_SCRIPT } from '@/lib/product';
import home from '../content/home.json';

const content = workbenchContent.parse(home);
const faqs = PRODUCT_FAQS.slice(0, 4);
for (const section of content.sections) {
  for (const block of section.blocks) {
    if (block.type === 'faq') block.items = faqs.map(faq => ({ ...faq }));
  }
}
const SITE_URL = 'https://rolepatch.com';
const jsonLd = productJsonLd(SITE_URL);
content.page.jsonLd = [jsonLd, {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question', name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
}];
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <meta name="application-name" content="RolePatch" />
    <meta name="author" content="RolePatch" />
    <meta name="creator" content="RolePatch" />
    <meta name="keywords" content="resume tailor, AI resume, ATS score, resume diff, job application, cover letter generator, resume keywords, resume optimizer, job fit score, interview prep, STAR stories" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:creator" content="@sarthakcodes" />
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="alternate" type="text/plain" href="/llms.txt" />
    <link rel="describedby" type="application/json" href="/api/ai" />
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_da27e32228b9bb96637405112579aadb17f0bdeaf1fa953c2d7572c26a07d6f8"
      data-project="app-import-5055bea54acfed7be5d386e53bc59d75c2b4566fd7b7404c470c7bc6c5b7c747"
      data-identity="session"
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
      data-vitals
      data-vitals-routes="changelog,docs,faq"
    ></script>
    <script is:inline>
      (function(c,l,a,r,i){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};var done=0,ev=["pointerdown","keydown","touchstart","scroll"];function go(){if(done)return;done=1;ev.forEach(function(e){removeEventListener(e,go)});var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)}ev.forEach(function(e){addEventListener(e,go,{passive:true,once:true})});setTimeout(go,90000)})(window,document,"clarity","script","y6buz6rkot");
      window.clarity("set","project_id","rolepatch");
    </script>
    <script is:inline set:html={APP_HEALTH_CLICK_SCRIPT}></script>
    <script is:inline set:html={REDIRECT_AUTHENTICATED_SCRIPT}></script>
    <style is:inline>
      /* Match Arial to the shipped Geist face at the hero's 450 weight.
         Size uses the headline's advance widths; vertical metrics use hhea. */
      @font-face {
        font-family: 'Geist Display Fallback';
        src: local('Arial');
        size-adjust: 106.2875%;
        ascent-override: 94.5549%;
        descent-override: 27.7549%;
        line-gap-override: 0%;
      }
      :root {
        --font-geist-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-geist-mono: ui-monospace, 'SFMono-Regular', Menlo, monospace;
      }
      body { margin: 0; }
    </style>
    <!-- Template links have no attribute passthrough; retain destination events. -->
    <script is:inline>
      document.addEventListener('click', function (event) {
        var target = event.target;
        var control = target && target.closest ? target.closest('a[href]') : null;
        if (!control || control.hasAttribute('data-app-health-event')) return;
        var events = {
          '/dashboard': 'workspace_opened',
          '/pricing': 'pricing_opened',
          '/tools': 'free_tools_opened'
        };
        var name = events[control.getAttribute('href')];
        if (name && window.appHealth && typeof window.appHealth.track === 'function') {
          window.appHealth.track(name);
        }
      });
    </script>
  </Fragment>
  <WorkbenchPage content={content} />
</Base>
