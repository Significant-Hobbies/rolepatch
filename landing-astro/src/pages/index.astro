---
import Layout from '@/layouts/Layout.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { PRODUCT_DESCRIPTION, PRODUCT_FAQS, PRODUCT_TITLE, TOKEN_PACKS } from '@/lib/product';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PRODUCT_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const workflow = [
  {
    number: '01',
    title: 'Bring one specific job',
    body: 'Paste the posting URL. RolePatch extracts the responsibilities, hard skills, language, and visible requirements that this application actually needs to answer.',
  },
  {
    number: '02',
    title: 'Match against existing proof',
    body: 'Your base resume, project stash, and achievement evidence are the only claim sources. Relevant proof moves forward; unsupported requirements stay visible as gaps.',
  },
  {
    number: '03',
    title: 'Inspect the proposed patch',
    body: 'The revised resume arrives with a word-level diff and a reason for each meaningful edit, tied back to the requirement or keyword that prompted it.',
  },
  {
    number: '04',
    title: 'Accept, edit, or leave it out',
    body: 'You keep control of the final wording. The accepted resume can then anchor a cover letter, fit analysis, interview stories, and a reviewed application packet.',
  },
] as const;

const packetItems = [
  ['Tailored resume', 'One saved version per role, with the base resume preserved.'],
  ['Fit analysis', 'Requirement coverage and visible gaps—not a universal hiring prediction.'],
  ['Cover letter', 'Role- and company-specific material grounded in the same supplied proof.'],
  ['STAR+R stories', 'Interview preparation mapped to the job and candidate evidence.'],
  ['Evidence bank', 'Reusable achievements with situation, action, result, metric, scope, and source context.'],
  ['Application packet', 'Resume, answers, proof, and receipt history collected for review.'],
] as const;

const stops = [
  ['CAPTCHA or human verification', 'Stop. No bypass attempt.'],
  ['Required answer is missing', 'Stop. Surface the exact answer gap.'],
  ['A file still needs selection', 'Stop. The user chooses the file explicitly.'],
  ['Submit state is ambiguous', 'Record a failed receipt for review.'],
] as const;
---

<Layout title={PRODUCT_TITLE} description={PRODUCT_DESCRIPTION} redirectAuthenticated>
  <div class="rolepatch-page">
    <SiteHeader active="home" />

    <main>
      <section class="hero-section paper-grid">
        <div class="site-shell hero-layout">
          <div class="hero-copy">
            <p class="section-label">For one serious application to one specific role</p>
            <h1>Tailor the resume.<br /><span>Keep the record true.</span></h1>
            <p class="hero-lede">
              RolePatch reads the job description, matches it against evidence already in your
              resume, and proposes a reviewable patch. It can reframe proof. It cannot invent it.
            </p>
            <div class="hero-actions">
              <a href="/dashboard" class="primary-action">Tailor a resume <span aria-hidden="true">↗</span></a>
              <a href="#proof" class="secondary-action">See the evidence rule <span aria-hidden="true">↓</span></a>
            </div>
            <dl class="hero-facts" aria-label="RolePatch access summary">
              <div><dt>Guest</dt><dd>Browser-local workspace</dd></div>
              <div><dt>Account</dt><dd>Optional Google sync</dd></div>
              <div><dt>Control</dt><dd>Review every patch</dd></div>
            </dl>
          </div>

          <div class="patch-board" aria-label="Illustrative evidence-bound resume patch">
            <div class="board-head">
              <span>Illustrative patch 07</span>
              <span class="status-dot">Evidence checked</span>
            </div>
            <div class="board-sheet requirement-sheet">
              <p class="board-label">Job requirement</p>
              <p>Own a TypeScript platform migration and show measurable reliability impact.</p>
            </div>
            <div class="board-connector" aria-hidden="true">↓</div>
            <div class="board-sheet source-sheet">
              <p class="board-label">Existing resume evidence</p>
              <p>Led migration of 11 services to TypeScript. Incident rate fell 34%.</p>
              <span class="source-tag">Supplied by candidate</span>
            </div>
            <div class="board-connector" aria-hidden="true">↓</div>
            <div class="board-sheet patch-sheet">
              <p class="board-label">Proposed wording</p>
              <p>
                Led a <mark>TypeScript migration</mark> across <mark>11 services</mark>, reducing
                incidents <mark>34%</mark>.
              </p>
              <span class="source-tag">Every fact traced to source</span>
            </div>
            <div class="gap-note">
              <span>Unsupported requirement: Kubernetes</span>
              <strong>Leave it out. Do not invent it.</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="definition-section">
        <div class="site-shell definition-grid">
          <div>
            <p class="section-label">What the product is</p>
            <h2>A focused preparation desk for a job seeker who cares about this application.</h2>
          </div>
          <div class="definition-copy">
            <p>
              A generic resume asks an employer to find the relevant evidence. RolePatch starts
              with the actual role, identifies what must be answered, and helps move supported
              proof into the foreground.
            </p>
            <p>
              The result is not an automatic application factory. It is a traceable set of
              materials the candidate can inspect, correct, accept, and carry into a review-first
              application workflow.
            </p>
            <a href="/evidence">Open the achievement evidence bank <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section id="method" class="method-section paper-grid">
        <div class="site-shell">
          <div class="section-heading split-heading">
            <div>
              <p class="section-label">The method</p>
              <h2>Job description in.<br />Reviewable patch out.</h2>
            </div>
            <p>
              The mechanism is intentionally simple enough to audit. Secondary features only
              matter after the candidate understands where each changed claim came from.
            </p>
          </div>
          <ol class="workflow-list">
            {workflow.map((step) => (
              <li>
                <span class="workflow-number">{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="proof" class="proof-section">
        <div class="site-shell">
          <div class="section-heading split-heading">
            <div>
              <p class="section-label">The evidence rule</p>
              <h2>Better phrasing is allowed.<br />Better fiction is not.</h2>
            </div>
            <p>
              RolePatch's tailoring instruction forbids adding a skill, metric, employer, tool, or
              accomplishment merely because the job description asks for it.
            </p>
          </div>

          <div class="redline-stage">
            <div class="redline-source">
              <div class="redline-meta">
                <span>Base resume · supplied text</span>
                <span>Requirement: platform reliability</span>
              </div>
              <p>
                Led the migration of 11 services to TypeScript and reduced production incidents
                by 34%.
              </p>
            </div>
            <div class="redline-arrow" aria-hidden="true">PATCH</div>
            <div class="redline-output">
              <div class="redline-meta">
                <span>Proposed resume · review required</span>
                <span>0 unsupported facts</span>
              </div>
              <p>
                Led a <ins>TypeScript platform migration</ins> across <ins>11 services</ins>,
                reducing <ins>production incidents 34%</ins>.
              </p>
              <ul>
                <li>“Platform” mirrors the job's language and remains supported by the 11-service scope.</li>
                <li>The service count and outcome are preserved exactly from supplied evidence.</li>
                <li>Kubernetes is omitted because the source does not demonstrate it.</li>
              </ul>
            </div>
          </div>
          <p class="proof-caption">
            This example is illustrative. The source line already contains every employer-facing
            fact shown in the patch.
          </p>
        </div>
      </section>

      <section class="packet-section">
        <div class="site-shell packet-layout">
          <div class="packet-intro">
            <p class="section-label">One application dossier</p>
            <h2>The resume is the start, not six disconnected AI outputs.</h2>
            <p>
              Once the resume patch is accepted, RolePatch can keep the role, evidence, materials,
              answers, and application history together. Each layer remains reviewable.
            </p>
            <a href="/dashboard" class="text-action">Build the role workspace <span aria-hidden="true">→</span></a>
          </div>
          <div class="packet-index">
            {packetItems.map(([title, body], index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{title}</h3><p>{body}</p></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="receipt-section">
        <div class="site-shell">
          <div class="receipt-heading">
            <div>
              <p class="section-label">Review-first application assistance</p>
              <h2>The stops are part of the product.</h2>
            </div>
            <p>
              Queueing, packet preparation, reviewed browser checks, Chrome-assisted fill, and
              guarded single-submit attempts can remove repetition. They do not remove the user.
            </p>
          </div>
          <div class="receipt-console">
            <div class="console-top">
              <span>APPLICATION RECEIPT · GREENHOUSE · REVIEW 03</span>
              <span class="console-status">BLOCKED SAFELY</span>
            </div>
            <div class="console-grid">
              <div>
                <p class="console-label">Prepared</p>
                <strong>12 fields</strong>
                <span>9 answered · 2 skipped · 1 needs review</span>
              </div>
              <div>
                <p class="console-label">Files</p>
                <strong>0 uploaded</strong>
                <span>User selection still required</span>
              </div>
              <div>
                <p class="console-label">Submit</p>
                <strong>Not attempted</strong>
                <span>Required answer missing</span>
              </div>
            </div>
            <div class="console-log">
              <span>10:14:07</span><p>Work authorization answer not found in reviewed profile.</p>
              <span>10:14:07</span><p>Submit guard engaged. No click sent to ATS.</p>
              <span>10:14:08</span><p>Failed receipt saved with next action: answer and retry.</p>
            </div>
          </div>
          <div class="stop-grid">
            {stops.map(([title, body]) => (
              <article><h3>{title}</h3><p>{body}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section class="access-section paper-grid">
        <div class="site-shell">
          <div class="section-heading split-heading">
            <div>
              <p class="section-label">Access and pricing</p>
              <h2>Start in the browser.<br />Pay for signed-in AI work when needed.</h2>
            </div>
            <p>
              RolePatch has a real mixed access model. Free browser tools, guest-local work,
              account persistence, and token-funded AI operations are different things.
            </p>
          </div>
          <div class="access-grid">
            <article>
              <p class="access-number">01</p>
              <h3>Guest browser</h3>
              <p>
                Resumes, jobs, tailored drafts, evidence, and application metadata can stay in the
                current browser. The current guest tailoring path does not debit account tokens.
              </p>
              <small>Clearing browser storage can remove guest data.</small>
            </article>
            <article>
              <p class="access-number">02</p>
              <h3>Google account</h3>
              <p>
                Sign-in adds user-scoped D1 persistence and starts a new account with three tokens.
                Signed-in AI tailoring, cover letters, fit scoring, interview prep, and outreach
                consume tokens.
              </p>
              <small>The reviewed queue, packet, fill, and receipt workflow does not spend tokens.</small>
            </article>
            <article>
              <p class="access-number">03</p>
              <h3>Token packs</h3>
              <ul class="price-list">
                {TOKEN_PACKS.map((pack) => <li><strong>{pack.tokens}</strong><span>{pack.price}</span></li>)}
              </ul>
              <small>
                No subscription. Purchase requires sign-in and working Dodo provider configuration;
                this audit did not complete a live transaction.
              </small>
            </article>
          </div>
          <div class="free-tools-strip">
            <p><strong>Free, local tools:</strong> ATS structure check · keyword overlap · bullet check · word count · resume diff · snippets</p>
            <a href="/tools">Use the free tools <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <section class="fit-section">
        <div class="site-shell fit-grid">
          <div>
            <p class="section-label">An honest fit</p>
            <h2>Use RolePatch when the role matters enough to inspect the details.</h2>
          </div>
          <div class="fit-columns">
            <article>
              <p class="fit-kicker">A good fit</p>
              <p>
                You have real experience to work with, a specific job description, and want the
                relevant proof stated clearly across the resume and supporting application.
              </p>
            </article>
            <article>
              <p class="fit-kicker">Not a fit</p>
              <p>
                You want invented qualifications, a universal hiring score, CAPTCHA solving,
                unattended file uploads, or bulk applications submitted without review.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="site-shell faq-layout">
          <div class="faq-intro">
            <p class="section-label">Straight answers</p>
            <h2>What happens to the resume, the data, and the application?</h2>
            <p>Precise enough for a candidate to decide whether RolePatch belongs in a real job search.</p>
            <a href="/faq" class="text-action">Read every answer <span aria-hidden="true">→</span></a>
          </div>
          <div class="faq-list">
            {PRODUCT_FAQS.slice(0, 6).map((faq, index) => (
              <details open={index === 0}>
                <summary>{faq.q}<span aria-hidden="true">+</span></summary>
                <p>{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="closing-section paper-grid">
        <div class="site-shell closing-grid">
          <div>
            <p class="section-label">The next application</p>
            <h2>Make the relevant truth easier to see.</h2>
          </div>
          <div>
            <p>
              Bring the job description and the resume you actually earned. RolePatch will help
              map one to the other—and show you the patch before you use it.
            </p>
            <a href="/dashboard" class="primary-action">Open RolePatch <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
    <SiteFooter />
  </div>
</Layout>
