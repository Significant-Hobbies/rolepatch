---
import { PublicFaq } from '../../../src/components/public-faq';
import Layout from '@/layouts/Layout.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { PRODUCT_FAQS } from '@/lib/product';

const TITLE = 'RolePatch FAQ — Evidence, pricing, privacy, and application safety';
const DESCRIPTION =
  'Direct answers about evidence-bound resume tailoring, guest storage, token pricing, the Chrome extension, and RolePatch’s review-first application workflow.';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PRODUCT_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Layout title={TITLE} description={DESCRIPTION} canonicalPath="/faq">
  <div class="rolepatch-page">
    <SiteHeader active="faq" />
    <PublicFaq />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
    <SiteFooter />
  </div>
</Layout>
