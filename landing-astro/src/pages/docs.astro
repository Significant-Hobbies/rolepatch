---
import { PublicDocs } from '../../../src/components/public-docs';
import Layout from '@/layouts/Layout.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';

const TITLE = 'RolePatch developer docs — Public discovery surfaces';
const DESCRIPTION =
  'Documentation for RolePatch’s read-only public catalog, LLM indexes, Markdown negotiation, OpenAPI schema, typed errors, and version policy.';


---

<Layout title={TITLE} description={DESCRIPTION} canonicalPath="/docs">
  <div class="rolepatch-page">
    <SiteHeader active="docs" />
    <PublicDocs />
    <SiteFooter />
  </div>
</Layout>
