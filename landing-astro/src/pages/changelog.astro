---
import { PublicChangelog } from '../../../src/components/public-changelog';
import Layout from '@/layouts/Layout.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';

const TITLE = 'RolePatch changelog — Verified product updates';
const DESCRIPTION =
  'Verified RolePatch updates to guest workflows, job discovery, review-first application assistance, receipts, proof, and release checks.';

---

<Layout title={TITLE} description={DESCRIPTION} canonicalPath="/changelog">
  <div class="rolepatch-page">
    <SiteHeader active="changelog" />
    <PublicChangelog />
    <SiteFooter />
  </div>
</Layout>
