---
import '@/styles/global.css';
import { APP_HEALTH_CLICK_SCRIPT, productJsonLd, REDIRECT_AUTHENTICATED_SCRIPT } from '@/lib/product';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  redirectAuthenticated?: boolean;
}

const SITE_URL = 'https://rolepatch.com';
const { title, description, canonicalPath = '/', redirectAuthenticated = false } = Astro.props;
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();
// Keep social previews on the stable raster asset; crawlers do not reliably
// render SVG Open Graph images.
const OG_IMAGE = `${SITE_URL}/og-image.png`;

const jsonLd = productJsonLd(SITE_URL);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="RolePatch" />
    <meta name="author" content="RolePatch" />
    <meta name="creator" content="RolePatch" />
    <meta
      name="keywords"
      content="resume tailor, AI resume, ATS score, resume diff, job application, cover letter generator, resume keywords, resume optimizer, job fit score, interview prep, STAR stories"
    />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="alternate" type="text/plain" href="/llms.txt" />
    <link rel="describedby" type="application/json" href="/api/ai" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="RolePatch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RolePatch — See every change in your resume" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:site" content="@sarthakcodes" />
    <meta name="twitter:creator" content="@sarthakcodes" />

    {/* Use the native UI stack on the static landing page. This avoids a
       late font swap moving and delaying the hero on constrained devices. */}
    <style is:inline>
      :root {
        --font-geist-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-geist-mono: ui-monospace, 'SFMono-Regular', Menlo, monospace;
      }
      body { margin: 0; }
    </style>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_da27e32228b9bb96637405112579aadb17f0bdeaf1fa953c2d7572c26a07d6f8"
      data-project="app-import-5055bea54acfed7be5d386e53bc59d75c2b4566fd7b7404c470c7bc6c5b7c747"
      data-identity="session"
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
    ></script>
    <script is:inline set:html={APP_HEALTH_CLICK_SCRIPT}></script>
  </head>
  <body class="antialiased">
    {
      redirectAuthenticated && (
        <script is:inline set:html={REDIRECT_AUTHENTICATED_SCRIPT}></script>
      )
    }
    <slot />
  </body>
</html>
