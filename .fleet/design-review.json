{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "rolepatch",
  "target": "RolePatch landing hero",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
    "selected": "existing-design",
    "approval": "not-required",
    "before": ".fleet/evidence/landing-hero/before-390.png"
  },
  "evidence": {
    "screenshots": [
      {
        "width": 390,
        "path": ".fleet/evidence/landing-hero/after-390.png"
      },
      {
        "width": 768,
        "path": ".fleet/evidence/landing-hero/after-768.png"
      },
      {
        "width": 1440,
        "path": ".fleet/evidence/landing-hero/after-1440.png"
      }
    ],
    "projectCheck": {
      "command": "pnpm --dir landing-astro build",
      "status": "pass"
    },
    "critique": {
      "score": 33,
      "maximum": 40
    },
    "audit": {
      "score": 17,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": [
        {
          "rule": "gradient-text",
          "count": 2,
          "disposition": "intentional incumbent treatment; unchanged in preserve pass"
        },
        {
          "rule": "ai-color-palette",
          "count": 4,
          "disposition": "existing indigo evidence accent; advisory for a future visual-language review"
        }
      ]
    },
    "browserReview": {
      "tool": "Playwright with system Chrome",
      "viewports": [390, 768, 1440],
      "horizontalOverflow": false,
      "consoleErrors": 0,
      "note": "At 390px, the headline height fell from 456px to 204px and the primary CTA moved from y=1006px to y=622px. Tablet navigation no longer overflows at 768px; desktop retains the 88px headline."
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "The owner explicitly delegated final design judgment for this remediation wave."
  }
}
